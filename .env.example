ANTHROPIC_API_KEY=
HEPTABASE_MCP_URL=https://api.heptabase.com/mcp
HEPTABASE_OAUTH_TOKEN=
# local heptabase backup export folder — when set, /api/heptabase/todos
# parses it directly (no AI/network) instead of calling Claude+MCP
HEPTABASE_BACKUP_DIR=
# google calendar (backend/src/adapters/calendar.ts) — Desktop-app OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# mint with: npm run auth:google --workspace backend
GOOGLE_REFRESH_TOKEN=
# optional, defaults to "primary"
GOOGLE_CALENDAR_ID=
# secondary calendar receiving explicitly published roadmap entries
GOOGLE_EXPORT_CALENDAR_ID=
PORT=4000
